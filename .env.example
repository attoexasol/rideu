# Server
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/drivewize

# Redis
REDIS_URL=redis://localhost:6379

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_API_IDENTIFIER=https://api.example.com
AUTH0_AUDIENCE=https://api.example.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_PASSENGER_CLIENT_ID=
JWT_SECRET=change-me-to-at-least-32-characters-long

# CORS
CORS_ORIGIN=http://localhost:8081

# Admin map (Mapbox) — not used by passenger Flutter app
MAPBOX_ACCESS_TOKEN=

# Passenger app Google Maps (server-side only — rotate if ever exposed)
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=BD
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_DEFAULT_COUNTRY=BD
GOOGLE_MAPS_REQUEST_TIMEOUT_MS=8000
GOOGLE_MAPS_CACHE_TTL_SECONDS=300
GOOGLE_MAPS_AUTOCOMPLETE_MIN_LENGTH=2
GOOGLE_MAPS_AUTOCOMPLETE_MAX_LENGTH=200
GOOGLE_MAPS_AUTOCOMPLETE_MAX_RESULTS=8
GOOGLE_MAPS_MAX_ROUTE_STOPS=3

# Rate limiting — declare each key ONCE (dotenv last-wins on duplicates).
# Global limiter is identity-aware: authenticated uses RATE_LIMIT_MAX_REQUESTS;
# unauthenticated uses RATE_LIMIT_UNAUTH_MAX_REQUESTS (stricter IP floor).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USE_REDIS=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=5000
RATE_LIMIT_UNAUTH_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX=100
PASSENGER_MAPS_RATE_LIMIT_WINDOW_MS=60000
PASSENGER_MAPS_RATE_LIMIT_MAX=300
PASSENGER_RATE_LIMIT_MAX=300
PASSENGER_BOOKING_READ_RATE_LIMIT_MAX=600
PASSENGER_CHECKOUT_RATE_LIMIT_MAX=30
BOOKING_RATE_LIMIT_MAX=100
PASSENGER_CANCEL_RATE_LIMIT_WINDOW_MS=60000
PASSENGER_CANCEL_RATE_LIMIT_MAX=30
DRIVER_RATE_LIMIT_MAX=600
DRIVER_LOCATION_RATE_LIMIT_WINDOW_MS=60000
DRIVER_LOCATION_RATE_LIMIT_MAX=1000
DRIVER_OFFER_RATE_LIMIT_MAX=300
DRIVER_RECOVERY_RATE_LIMIT_MAX=300
SOFT_METER_RATE_LIMIT_MAX=1000
VIDEO_UPLOAD_RATE_LIMIT_MAX=120

# Logging
LOG_LEVEL=info

# Dispatch & driver eligibility
DRIVER_LOCATION_STALE_SECONDS=120
DISPATCH_RADIUS_KM=15
DISPATCH_BATCH_SIZE=5
DISPATCH_OFFER_TIMEOUT_SECONDS=45
DISPATCH_MAX_BATCHES=3

# Private, booking-linked ride video recording
VIDEO_RECORDING_ENABLED=false
VIDEO_RECORDING_CONSENT_REQUIRED=true
VIDEO_SEGMENT_DURATION_SECONDS=10
VIDEO_MAX_SEGMENT_SIZE_BYTES=25000000
VIDEO_UPLOAD_URL_TTL_SECONDS=300
VIDEO_READ_URL_TTL_SECONDS=300
VIDEO_RETENTION_DAYS=30
VIDEO_STORAGE_CONTAINER=ride-recordings
VIDEO_STORAGE_ROOT=private-media
# Optional LAN/public host for absolute signed upload URLs (required for physical Android devices)
# VIDEO_API_PUBLIC_BASE_URL=http://192.168.1.100:3000
# Required in production when VIDEO_RECORDING_ENABLED=true (minimum 32 characters)
VIDEO_SIGNING_SECRET=

# Private driver license/insurance documents (reuses VIDEO_STORAGE_ROOT by default)
# DRIVER_DOCUMENT_STORAGE_ROOT=private-media
# DRIVER_DOCUMENT_STORAGE_CONTAINER=driver-documents
DRIVER_DOCUMENT_MAX_BYTES=10485760
DRIVER_DOCUMENT_READ_URL_TTL_SECONDS=300
# DRIVER_DOCUMENT_SIGNING_SECRET=

DB_TRANSACTION_TIMEOUT_MS=8000
ACCEPT_REQUEST_TIMEOUT_MS=15000

# QR duty rollout (set true after Kotlin duty flow is deployed)
QR_DUTY_REQUIRED=false

# Driver FCM ride-offer push (optional). Socket.IO + REST recovery still work when disabled.
FCM_ENABLED=false
# FIREBASE_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Two-driver vehicle exchange
VEHICLE_EXCHANGE_TTL_SECONDS=300
VEHICLE_EXCHANGE_FORCE_COMPLETE_ENABLED=false

# Admin fleet vehicle list (frontend may request limit=1000)
ADMIN_FLEET_VEHICLE_LIST_MAX_LIMIT=1000

# Stripe (optional — cash bookings work without these)
# Test-mode keys only in development. Never commit live secrets.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# ISO 3166-1 alpha-2. Required to create connected accounts. Do not use BD merely because fares are BDT.
# STRIPE_CONNECT_DEFAULT_COUNTRY=US
# STRIPE_CONNECT_RETURN_URL=https://example.com/driver/payouts/return
# STRIPE_CONNECT_REFRESH_URL=https://example.com/driver/payouts/refresh
# Hosted Soft Meter Checkout is not created while metered charging is unreleased.
# Stripe TEST Checkout for walk-up and on-demand are separate switches.
# They do not enable live / production metered charging.
# Leave both payment flags unset or false in production.
# Each accepts only sk_test keys. A live key is rejected.
# On NODE_ENV=production the process must also set the matching SANDBOX=authorized flag.
# WALKUP_STRIPE_TEST_PAYMENTS=false
# WALKUP_STRIPE_TEST_SANDBOX=
# ONDEMAND_STRIPE_TEST_PAYMENTS=false
# ONDEMAND_STRIPE_TEST_SANDBOX=
# Browser return URLs for hosted Checkout. Webhook confirmation marks Paid.
# Local device QA should use the machine LAN IP, not localhost, for phone browsers.
# METER_CHECKOUT_SUCCESS_URL=http://127.0.0.1:3000/meter/payment/return
# METER_CHECKOUT_CANCEL_URL=http://127.0.0.1:3000/meter/payment/cancel

# Development only
BYPASS_AUTH=false
