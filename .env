# =============================================================================
# DriveWize Backend — Environment Variables
# Generated from project analysis (src/). No application logic was changed.
# =============================================================================

# --- Application ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Database (runtime: DATABASE_URL; scripts: DB_* for create-database) ---
DATABASE_URL=postgresql://neondb_owner:npg_P6vafEXL5RAb@ep-long-mouse-apozupbw-pooler.c-7.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_HOST=ep-long-mouse-apozupbw-pooler.c-7.us-east-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=npg_P6vafEXL5RAb

# DATABASE_URL=postgresql://postgres:AttoExa123@localhost:5432/ryd_u
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ryd_u
# DB_USER=postgres
# DB_PASSWORD=AttoExa123

# --- Redis (WebSocket adapter when USE_REDIS=true) ---
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
USE_REDIS=false

# --- CORS & rate limiting ---
# Comma-separated origins (e.g. http://localhost:5173,http://localhost:8081)
CORS_ORIGIN=http://localhost:5173,http://localhost:8081
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000

# --- Auth0 (JWT verification & API) ---
# Domain without https:// (e.g. your-tenant.auth0.com)
AUTH0_DOMAIN=
AUTH0_API_IDENTIFIER=https://api.drivewize.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Auth0 Management API (admin user operations)
AUTH0_MANAGEMENT_CLIENT_ID=
AUTH0_MANAGEMENT_CLIENT_SECRET=

# --- JWT (legacy/session routes in routes/auth.ts) ---
JWT_SECRET=your-jwt-secret-key
JWT_EXPIRES_IN=24h

# --- Development / testing ---
# Set to true to skip Auth0 and use a mock user (never use in production)
BYPASS_AUTH=true

# --- Mapbox (road snapping / map matching) ---
MAPBOX_ACCESS_TOKEN=

# --- Production monitoring (optional; validated in production) ---
SENTRY_DSN=
