# DriveWize backend — PRODUCTION environment template
# Copy to /opt/drivewize/production/.env.production on the VPS.
# Fill placeholders with production values. Never commit real secrets.
#
# NODE_ENV must be "production" (env-validator production required set).
# Keep METERED_CHARGING_RELEASED=false in application source.
# Stripe: use TEST keys until the client explicitly authorizes live payments.
# If enabling walk-up/on-demand Stripe TEST flows on NODE_ENV=production, also set
# WALKUP_STRIPE_TEST_SANDBOX=authorized and/or ONDEMAND_STRIPE_TEST_SANDBOX=authorized.
#
# Public HTTPS: https://api.corryde.com (API) and https://admin.corryde.com (Admin).
# VPS: 82.180.139.178  Path: /opt/drivewize/production

# ---------------------------------------------------------------------------
# Compose / infrastructure
# ---------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=drivewize-production
# Prefer immutable digests from CI (same commit for both images).
BACKEND_IMAGE=ghcr.io/attoexasol/rideu:production
MIGRATE_IMAGE=ghcr.io/attoexasol/rideu:production-migrate

POSTGRES_DB=ryd_u
POSTGRES_USER=drivewize
POSTGRES_PASSWORD=CHANGE_ME_PRODUCTION_DB_PASSWORD

REDIS_PASSWORD=CHANGE_ME_PRODUCTION_REDIS_PASSWORD

DATABASE_URL=postgresql://drivewize:CHANGE_ME_PRODUCTION_DB_PASSWORD@postgres:5432/ryd_u
REDIS_URL=redis://:CHANGE_ME_PRODUCTION_REDIS_PASSWORD@redis:6379

# --- Edge: public HTTPS (Caddy automatic certificates) ---
# DNS A records for both hostnames must point at 82.180.139.178.
# 80/443 public (UFW allow 80/tcp, 443/tcp). 8081 is always loopback-only.
CADDY_PUBLIC_BIND_ADDRESS=0.0.0.0
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_ADMIN_HTTP_PORT=8081
CADDY_SITE_ADDRESS=api.corryde.com
ADMIN_SITE_ADDRESS=admin.corryde.com
CADDY_ACME_EMAIL=ops@drivewize.co
# Deploy gate: loopback emergency site → backend (independent of ACME).
HEALTHCHECK_URL=http://127.0.0.1:8081/api/health

# Emergency Admin access from a laptop (8081 is never public):
#   ssh -L 8081:127.0.0.1:8081 deploy@82.180.139.178
#   open http://127.0.0.1:8081/

# ---------------------------------------------------------------------------
# Application (production required by src/config/env-validator.ts)
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

AUTH0_DOMAIN=your-tenant.auth0.com
# Must equal the Auth0 API "Identifier" exactly (it is a logical audience, not
# necessarily a reachable URL). Keep the existing value unless a new Auth0 API
# with identifier https://api.corryde.com is created and all apps are switched.
AUTH0_API_IDENTIFIER=CHANGE_ME_AUTH0_API_IDENTIFIER
AUTH0_AUDIENCE=CHANGE_ME_AUTH0_API_IDENTIFIER
AUTH0_ALGORITHM=RS256
AUTH0_CLIENT_ID=CHANGE_ME_AUTH0_CLIENT_ID
AUTH0_CLIENT_SECRET=CHANGE_ME_AUTH0_CLIENT_SECRET
AUTH0_PASSENGER_CLIENT_ID=CHANGE_ME_AUTH0_PASSENGER_CLIENT_ID
AUTH0_MANAGEMENT_CLIENT_ID=CHANGE_ME_AUTH0_MANAGEMENT_CLIENT_ID
AUTH0_MANAGEMENT_CLIENT_SECRET=CHANGE_ME_AUTH0_MANAGEMENT_CLIENT_SECRET

JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_CHARACTERS_LONG_PRODUCTION
JWT_EXPIRES_IN=24h
BYPASS_AUTH=false

# Comma-separated browser origins (REST + Socket.IO). Add
# http://127.0.0.1:8081 only while using the emergency tunnel from a browser.
CORS_ORIGIN=https://admin.corryde.com

# Public base for absolute media/upload URLs returned to apps.
API_PUBLIC_BASE_URL=https://api.corryde.com
VIDEO_API_PUBLIC_BASE_URL=https://api.corryde.com

USE_REDIS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_USE_REDIS=true
LOG_LEVEL=info

# Required in production by env-validator
MAPBOX_ACCESS_TOKEN=CHANGE_ME_MAPBOX_TOKEN
GOOGLE_MAPS_API_KEY=CHANGE_ME_GOOGLE_MAPS_API_KEY
GOOGLE_MAPS_REGION=US
GOOGLE_MAPS_LANGUAGE=en
GOOGLE_MAPS_DEFAULT_COUNTRY=US

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
VIDEO_RECORDING_ENABLED=false
VIDEO_RECORDING_CONSENT_REQUIRED=true
VIDEO_STORAGE_ROOT=/app/private-media
VIDEO_STORAGE_CONTAINER=ride-recordings
VIDEO_SIGNING_SECRET=CHANGE_ME_VIDEO_SIGNING_SECRET_AT_LEAST_32_CHARS
DRIVER_DOCUMENT_STORAGE_ROOT=/app/private-media
DRIVER_DOCUMENT_STORAGE_CONTAINER=driver-documents
AVATAR_STORAGE_ROOT=/app/uploads

# ---------------------------------------------------------------------------
# Stripe — TEST mode until live payments are explicitly authorized
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_CONNECT_DEFAULT_COUNTRY=US
STRIPE_CONNECT_RETURN_URL=https://admin.corryde.com/driver/payouts/return
STRIPE_CONNECT_REFRESH_URL=https://admin.corryde.com/driver/payouts/refresh

WALKUP_STRIPE_TEST_PAYMENTS=false
ONDEMAND_STRIPE_TEST_PAYMENTS=false
# Required ONLY if enabling the test payment switches above while NODE_ENV=production:
# WALKUP_STRIPE_TEST_SANDBOX=authorized
# ONDEMAND_STRIPE_TEST_SANDBOX=authorized
# Served by the backend (src/index.ts), so these use the API host.
METER_CHECKOUT_SUCCESS_URL=https://api.corryde.com/meter/payment/return
METER_CHECKOUT_CANCEL_URL=https://api.corryde.com/meter/payment/cancel

# ---------------------------------------------------------------------------
# FCM (optional)
# ---------------------------------------------------------------------------
FCM_ENABLED=false

# ---------------------------------------------------------------------------
# Dispatch (optional overrides)
# ---------------------------------------------------------------------------
DRIVER_LOCATION_STALE_SECONDS=120
DISPATCH_RADIUS_KM=15
DISPATCH_BATCH_SIZE=5
DISPATCH_OFFER_TIMEOUT_SECONDS=45
DISPATCH_MAX_BATCHES=3
QR_DUTY_REQUIRED=false
