# DriveWize production Caddy — public HTTPS
#
#   CADDY_SITE_ADDRESS=api.corryde.com     → backend:3000 (REST, Socket.IO, uploads, meter pages)
#   ADMIN_SITE_ADDRESS=admin.corryde.com   → /api, /socket.io, /uploads → backend:3000
#                                            everything else → drivewize-admin:8080 (SPA)
#   :8081 (Compose binds it to 127.0.0.1 only) → emergency Admin access over SSH tunnel:
#     ssh -L 8081:127.0.0.1:8081 deploy@82.180.139.178
#     curl -fsS http://127.0.0.1:8081/api/health
#
# Both site addresses must be hostnames whose DNS A records point at this VPS.
# Automatic HTTPS (ACME issuance + renewal) is on; certificates and ACME
# account state persist in the drivewize_production_caddy_data volume (/data).
# Port 80 on the hostnames redirects to HTTPS (ACME HTTP-01 is still served).
#
# Stripe webhook: POST /api/v1/webhooks/stripe (raw body preserved by Express).
# Express trust proxy = 1 (single Caddy hop).
{
	email {$CADDY_ACME_EMAIL:ops@drivewize.co}
}

(security_headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

(hsts) {
	header Strict-Transport-Security "max-age=31536000"
}

# Long-lived streaming (Socket.IO long-polling / WebSocket upgrades).
(backend_proxy) {
	request_body {
		max_size 35MB
	}
	reverse_proxy backend:3000 {
		header_up X-Real-IP {remote_host}

		transport http {
			read_timeout 0
			write_timeout 0
		}
	}
}

(admin_routes) {
	@backend path /api /api/* /socket.io /socket.io/* /uploads /uploads/*
	handle @backend {
		import backend_proxy
	}

	handle {
		reverse_proxy drivewize-admin:8080
	}
}

(access_log) {
	log {
		output stdout
		format console
	}
}

{$CADDY_SITE_ADDRESS} {
	encode gzip zstd
	import security_headers
	import hsts
	import backend_proxy
	import access_log
}

{$ADMIN_SITE_ADDRESS} {
	encode gzip zstd
	import security_headers
	import hsts
	import admin_routes
	import access_log
}

# Emergency loopback Admin + API (plain HTTP, never published publicly).
:8081 {
	encode gzip zstd
	import security_headers
	import admin_routes
	import access_log
}
